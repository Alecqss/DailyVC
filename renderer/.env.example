# Highlight.gg — Variables d'environnement du renderer (VM GPU Scaleway)
# À passer au `docker run` sur la VM (voir docs/scaleway-deploy.md)

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=cd927c02767137b993fc0d51fc73682a
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_DEMOS=csplays-gg-demos
R2_BUCKET_CLIPS=csplays-gg-clips

# ── Steam (compte dédié — Steam Guard email désactivé) ──────────────────────────
# CS2 se télécharge en anonyme, MAIS le CLIENT Steam doit être loggé pour que
# le binaire cs2 démarre (SteamAPI_Init). D'où le besoin du compte dédié.
STEAM_USERNAME=csplaysgg
STEAM_PASSWORD=
STEAM_LOGIN_TIMEOUT=180         # secondes d'attente du login au démarrage

# ── CS2 ───────────────────────────────────────────────────────────────────────
CS2_DIR=/data/cs2               # disque persistant monté dans le conteneur
CS2_TICKRATE=64
CS2_FPS=60
CS2_WIDTH=1280
CS2_HEIGHT=720
CS2_CAPTURE_TIMEOUT=600         # secondes max par clip

# ── ffmpeg ────────────────────────────────────────────────────────────────────
FFMPEG_CRF=18                   # qualité H.264 (18=haute, 23=correcte)

# ── Renderer ─────────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=10
