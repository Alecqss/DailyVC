# Highlight.gg — Variables d'environnement du renderer (RunPod)
# Copier et remplir sur le pod RunPod (Environment Variables)

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=cd927c02767137b993fc0d51fc73682a
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_DEMOS=csplays-gg-demos
R2_BUCKET_CLIPS=csplays-gg-clips

# ── Steam ─────────────────────────────────────────────────────────────────────
# Plus nécessaire : CS2 (app 730) se télécharge en login anonyme (voir entrypoint.sh).
# Aucune variable Steam requise.

# ── CS2 ───────────────────────────────────────────────────────────────────────
CS2_DIR=/workspace/cs2          # volume persistant RunPod (ne pas changer)
CS2_TICKRATE=64
CS2_FPS=60
CS2_WIDTH=1280
CS2_HEIGHT=720
CS2_CAPTURE_TIMEOUT=600         # secondes max par clip

# ── ffmpeg ────────────────────────────────────────────────────────────────────
FFMPEG_CRF=18                   # qualité H.264 (18=haute, 23=correcte)

# ── Renderer ─────────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=10
